# =============================================================================
# struxio — environment configuration (self-hosted OSS)
# Copy to .env and fill in the required values.
# Variables marked (optional) have sensible defaults.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://struxio:struxio@localhost:5432/struxio

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used as the extraction job queue (Redis Streams).
REDIS_URL=redis://127.0.0.1:6379

# ── Worker (optional) ─────────────────────────────────────────────────────────
# Concurrent Redis Stream consumers. Claim idle should exceed GEMINI_TIMEOUT_SECS.
WORKER_CONCURRENCY=8
WORKER_MAX_ATTEMPTS=5
WORKER_INITIAL_BACKOFF_MS=1000
WORKER_MAX_BACKOFF_MS=60000
# WORKER_CLAIM_IDLE_SECS=150

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
# Use the bundled docker-compose MinIO service for local dev.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=struxio
S3_REGION=us-east-1              # (optional) default: us-east-1

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash    # (optional) default: gemini-2.5-flash
GEMINI_TIMEOUT_SECS=120           # (optional) default: 120

# ── Auth ──────────────────────────────────────────────────────────────────────
# Static bearer token used to authenticate all API requests.
# Set to any secret string — treat it like a password.
STRUXIO_API_KEY=change-me-to-a-strong-secret

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0              # (optional) default: 0.0.0.0
SERVER_PORT=8080                 # (optional) default: 8080
LOG_LEVEL=info                   # (optional) default: info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Leave empty to allow all (*).
CORS_ALLOWED_ORIGINS=
